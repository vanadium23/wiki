# Dev-стенд v5: собираем Quartz-статику, отдаёт nginx.
FROM node:22-alpine AS build
# git нужен для установки quartz v5 community-плагинов
RUN apk add --no-cache git
# host lockfile is npm 11 format; image ships npm 10 which mis-reads it
RUN npm install -g npm@11
WORKDIR /app
COPY package.json package-lock.json ./
# npm install (not ci): lockfile regenerated by npm 11 on host trips EUSAGE
# inside the build context; install resolves regardless — acceptable for a dev stand
RUN npm install --no-audit --no-fund
COPY . .
# direct invocation: npx resolves the wrong (npm) quartz package; the repo's
# bin is quartz/bootstrap-cli.mjs
RUN node ./quartz/bootstrap-cli.mjs build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/public /usr/share/nginx/html
